# Frontend build config (baked in at build time — ADR-0011).
# Copy to .env.local for development; set in CI/deploy for production builds.

# Dev: leave empty (vite proxies /api to localhost:8000).
# Deployed build on LabServer: ALSO leave empty — nginx proxies /api on the same
# origin (ADR-0016). Set a full URL only if the API lives on another host.
VITE_API_BASE_URL=