[Unit]
Description=HMS FastAPI backend (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__REPO_USER__
WorkingDirectory=__REPO__/backend
# Loopback only: clients reach the API through nginx on port 80 (ADR-0016).
# --proxy-headers trusts nginx's X-Forwarded-For so logs show the real client IP.
ExecStart=__REPO__/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target